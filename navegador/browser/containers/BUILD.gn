# Containers: núcleo sem dependência de UI, pra poder ser usado pelos
# módulos pequenos do chrome/browser (navigator, tabrestore, sessions).
source_set("containers") {
  sources = [
    "claude.cc",
    "claude.h",
    "containers.cc",
    "containers.h",
    "espacos_dados.cc",
    "espacos_dados.h",
    "fixos.cc",
    "fixos.h",
    "titulos.cc",
    "titulos.h",
  ]
  deps = [
    "//base",
    "//chrome/browser/profiles:profile",
    "//components/pref_registry",
    "//components/prefs",
    "//content/public/browser",
    "//services/network/public/mojom",
    "//url",
  ]
}
