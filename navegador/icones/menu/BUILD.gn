    "proxima.icon",
    "qr_code.icon",
    "redo_2.icon",
    "repeat.icon",
    "rotate_cw.icon",
    "scissors.icon",
    "search.icon",
    "spell_check.icon",
    "square_arrow_out_up_right.icon",
    "square_mouse_pointer.icon",
