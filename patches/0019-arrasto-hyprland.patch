+    EXPECT_FALSE(drag_controller()->navegador_sondando_);
+  }));
+
+  NavegadorArrastarComMiniatura(window_.get(), drag_started_callback_,
+                                drag_finished_callback_);
+  EXPECT_EQ(drag_controller_state(), WaylandDataDragController::State::kIdle);
+}
+
+// Sem miniatura não dá pra saber: vale o dnd_finished, como no Chromium.
+TEST_P(WaylandDataDragControllerTest, NavegadorFimSemMiniatura) {
+  NAVEGADOR_SO_NO_HYPRLAND();
+  FocusAndPressLeftPointerButton(window_.get(), &delegate_);
+
+  ScheduleTestTask(base::BindLambdaForTesting([&]() {
