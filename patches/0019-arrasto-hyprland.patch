+  EXPECT_EQ(drag_controller_state(), WaylandDataDragController::State::kIdle);
+}
+
+// Soltar de verdade (dnd_drop_performed + dnd_finished) acaba na hora.
+TEST_P(WaylandDataDragControllerTest, NavegadorSoltarNoHyprland) {
+  NAVEGADOR_SO_NO_HYPRLAND();
+  FocusAndPressLeftPointerButton(window_.get(), &delegate_);
