+// navegador: testes do dnd_finished sem dnd_drop_performed no Hyprland (ver
+// WaylandDataDragController::OnDataSourceFinish). Rodar com
+// HYPRLAND_INSTANCE_SIGNATURE no ambiente (e os outros testes sem).
+#define NAVEGADOR_SO_NO_HYPRLAND()                          \
+  if (!getenv("HYPRLAND_INSTANCE_SIGNATURE")) {             \
+    GTEST_SKIP() << "só com HYPRLAND_INSTANCE_SIGNATURE"; \
+  }
+
+namespace {
+
+// Arrasto com miniatura (o Hyprland desenha ela a cada quadro enquanto o
+// arrasto continua).
+void NavegadorArrastarComMiniatura(
+    WaylandWindow* janela,
+    base::MockOnceClosure& comecou,
+    base::MockCallback<WmDragHandler::DragFinishedCallback>& acabou) {
+  OSExchangeData dados;
+  dados.SetString(u"Norte");
+  SkBitmap bitmap;
+  bitmap.allocN32Pixels(20, 20);
+  bitmap.eraseColor(SK_ColorRED);
+  dados.provider().SetDragImage(gfx::ImageSkia::CreateFrom1xBitmap(bitmap),
+                                gfx::Vector2d(10, 10));
+  EXPECT_CALL(comecou, Run()).Times(1);
+  janela->StartDrag(dados, DragDropTypes::DRAG_COPY | DragDropTypes::DRAG_MOVE,
+                    DragEventSource::kMouse, /*cursor=*/{},
+                    /*can_grab_pointer=*/true, comecou.Get(), acabou.Get(),
+                    /*location_delegate=*/nullptr);
+}
+
+}  // namespace
+
+// Por cima do Zed: dnd_finished sem dnd_drop_performed e a miniatura ainda
+// desenhada: o arrasto continua; o cancelled de quando ele solta acaba.
+TEST_P(WaylandDataDragControllerTest, NavegadorFimFalsoDoHyprlandContinua) {
+  NAVEGADOR_SO_NO_HYPRLAND();
+  FocusAndPressLeftPointerButton(window_.get(), &delegate_);
+
+  ScheduleTestTask(base::BindLambdaForTesting([&]() {
+    EXPECT_CALL(drag_finished_callback_, Run(_)).Times(0);
+    SendDndFinished();
+    EXPECT_TRUE(drag_controller()->navegador_sondando_);
+    const uint32_t icone =
+        drag_controller()->icon_surface_->get_surface_id();
+    PostToServerAndWait([icone](wl::TestWaylandServerThread* server) {
+      auto* superficie = server->GetObject<wl::MockSurface>(icone);
+      ASSERT_TRUE(superficie);
+      superficie->SendFrameCallback();
+    });
+  }));
+  ScheduleTestTask(base::BindLambdaForTesting([&]() {
+    EXPECT_TRUE(drag_controller()->data_source_);
+    EXPECT_FALSE(drag_controller()->navegador_sondando_);
+    EXPECT_TRUE(drag_controller()->navegador_fim_falso_);
+    Mock::VerifyAndClearExpectations(&drag_finished_callback_);
+    // O arrasto segue: passa pela janela de novo.
+    SendMotionEvent(gfx::Point(30, 40));
+  }));
+  ScheduleTestTask(base::BindLambdaForTesting([&]() {
+    EXPECT_TRUE(drag_controller()->data_source_);
+    EXPECT_CALL(drag_finished_callback_, Run(DragOperation::kNone)).Times(1);
+    SendDndCancelled();
+  }));
+
+  NavegadorArrastarComMiniatura(window_.get(), drag_started_callback_,
+                                drag_finished_callback_);
+  EXPECT_EQ(drag_controller_state(), WaylandDataDragController::State::kIdle);
+  EXPECT_FALSE(drag_controller()->data_source_);
+}
+
+// Soltou numa janela que destruiu a oferta sem finish (Electron, XWayland):
+// sem quadro da miniatura, é o fim de verdade.
+TEST_P(WaylandDataDragControllerTest, NavegadorFimSemQuadroDaMiniatura) {
+  NAVEGADOR_SO_NO_HYPRLAND();
+  FocusAndPressLeftPointerButton(window_.get(), &delegate_);
+
+  ScheduleTestTask(base::BindLambdaForTesting([&]() {
+    EXPECT_CALL(drag_finished_callback_, Run(_)).Times(1);
+    SendDndLeave();
+    SendDndFinished();
+    EXPECT_TRUE(drag_controller()->navegador_sondando_);
+  }));
+
+  NavegadorArrastarComMiniatura(window_.get(), drag_started_callback_,
+                                drag_finished_callback_);
+  EXPECT_EQ(drag_controller_state(), WaylandDataDragController::State::kIdle);
+  EXPECT_FALSE(drag_controller()->data_source_);
+}
+
+// Soltou numa janela nossa (a outra janela do Norte): o dnd_finished que vem
+// depois é o fim, na hora.
+TEST_P(WaylandDataDragControllerTest, NavegadorSoltarNumaJanelaNossa) {
+  NAVEGADOR_SO_NO_HYPRLAND();
+  FocusAndPressLeftPointerButton(window_.get(), &delegate_);
+
+  ScheduleTestTask(base::BindLambdaForTesting([&]() {
