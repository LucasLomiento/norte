+// navegador: no Hyprland, um dnd_finished sem dnd_drop_performed (a janela
+// de outro programa destruiu a oferta com o ponteiro em cima) não acaba o
+// arrasto; o cancelled de quando ele solta, sim. Rodar com
+// HYPRLAND_INSTANCE_SIGNATURE no ambiente (e os outros testes sem).
+TEST_P(WaylandDataDragControllerTest, NavegadorFimFalsoDoHyprlandContinua) {
+  if (!getenv("HYPRLAND_INSTANCE_SIGNATURE")) {
+    GTEST_SKIP() << "só com HYPRLAND_INSTANCE_SIGNATURE";
+  }
+  FocusAndPressLeftPointerButton(window_.get(), &delegate_);
+
+  ScheduleTestTask(base::BindLambdaForTesting([&]() {
+    EXPECT_CALL(drag_finished_callback_, Run(_)).Times(0);
+    SendDndFinished();
+    EXPECT_TRUE(drag_controller()->data_source_);
+    EXPECT_NE(drag_controller_state(), WaylandDataDragController::State::kIdle);
+    Mock::VerifyAndClearExpectations(&drag_finished_callback_);
+  }));
+  // O arrasto segue: passa pela janela de novo.
+  ScheduleTestTask(base::BindLambdaForTesting([&]() {
+    SendMotionEvent(gfx::Point(30, 40));
+    EXPECT_TRUE(drag_controller()->data_source_);
+  }));
+  ScheduleTestTask(base::BindLambdaForTesting([&]() {
+    EXPECT_CALL(drag_finished_callback_, Run(DragOperation::kNone)).Times(1);
+    SendDndCancelled();
+  }));
+
+  RunMouseDragWithSampleData(
+      window_.get(), DragDropTypes::DRAG_COPY | DragDropTypes::DRAG_MOVE);
+  EXPECT_EQ(drag_controller_state(), WaylandDataDragController::State::kIdle);
+  EXPECT_FALSE(drag_controller()->data_source_);
+}
+
+// navegador: soltar de verdade (dnd_drop_performed + dnd_finished) continua
+// acabando o arrasto no Hyprland.
+TEST_P(WaylandDataDragControllerTest, NavegadorSoltarNoHyprland) {
+  if (!getenv("HYPRLAND_INSTANCE_SIGNATURE")) {
+    GTEST_SKIP() << "só com HYPRLAND_INSTANCE_SIGNATURE";
+  }
+  FocusAndPressLeftPointerButton(window_.get(), &delegate_);
+
+  ScheduleDataDeviceAction(WL_DATA_DEVICE_MANAGER_DND_ACTION_COPY);
+  ScheduleTestTask(base::BindLambdaForTesting([&]() {
+    EXPECT_CALL(drag_finished_callback_, Run(DragOperation::kCopy)).Times(1);
+    SendDndDropPerformed();
+    SendDndFinished();
+  }));
+
+  RunMouseDragWithSampleData(
+      window_.get(), DragDropTypes::DRAG_COPY | DragDropTypes::DRAG_MOVE);
+  EXPECT_EQ(drag_controller_state(), WaylandDataDragController::State::kIdle);
+}
+
+// navegador: depois do dnd_finished falso, soltando numa janela do XWayland
+// nada mais chega; o ponteiro voltando pra uma janela nossa acaba o arrasto.
+TEST_P(WaylandDataDragControllerTest, NavegadorFimFalsoPonteiroDeVolta) {
