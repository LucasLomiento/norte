+void WaylandDataDragController::NavegadorPonteiroEntrou(
+    base::TimeTicks timestamp) {
+  if (!navegador_fim_falso_ || state_ == State::kIdle) {
+    return;
+  }
+  VLOG(1) << "navegador: ponteiro de volta depois do dnd_finished falso, "
+             "fim do arrasto";
+  HandleDragEnd(DragResult::kCancelled, timestamp);
+  Reset();
+}
