+// navegador: fechar a última aba do espaço em uso (o grupo focado) ou da
+// janela não troca de espaço nem fecha a janela: como no Zen, entra uma aba
+// nova no fim do grupo antes (no container do espaço, que a aba nova pega do
+// grupo focado: browser_navigator.cc). Fechar a janela inteira e excluir o
+// espaço vêm por outro caminho (CloseAllTabs, CloseAllTabsInGroup).
+// Devolve a aba nova, pra ativar depois de fechar (NavegadorAtivar).
+tabs::TabHandle NavegadorManterEspaco(
+    TabStripModel* model,
+    const std::vector<tabs::TabInterface*>& fechando) {
+  // Só nas janelas de abas: popup, app e DevTools fecham com a última aba
+  // (a aba nova delas ia parar numa janela normal). A anônima não tem
+  // espaços: fechar a última aba fecha a janela, como no Chromium.
+  if (fechando.empty() || model->closing_all() || !model->delegate() ||
+      !model->delegate()->IsNormalWindow() ||
+      model->profile()->IsOffTheRecord()) {
+    return tabs::TabHandle();
+  }
+  const auto fecha = [&fechando](tabs::TabInterface* aba) {
+    return std::ranges::find(fechando, aba) != fechando.end();
+  };
+  const std::optional<tab_groups::TabGroupId> grupo =
+      model->GetFocusedGroup();
+  // O espaço temporário (o grupo de uma extensão) fecha com a última aba.
+  if (grupo && navegador::espacos::GrupoTemporario(model->profile(),
+                                                   grupo->ToString())) {
+    return tabs::TabHandle();
+  }
+  int index = -1;
+  if (grupo && model->group_model() &&
+      model->group_model()->ContainsTabGroup(*grupo)) {
+    const gfx::Range abas =
+        model->group_model()->GetTabGroup(*grupo)->ListTabs();
+    for (size_t i = abas.start(); i < abas.end(); ++i) {
+      if (!fecha(model->GetTabAtIndex(static_cast<int>(i)))) {
+        return tabs::TabHandle();
+      }
+    }
+    index = static_cast<int>(abas.end());
+  } else {
+    for (int i = 0; i < model->count(); ++i) {
+      if (!fecha(model->GetTabAtIndex(i))) {
+        return tabs::TabHandle();
+      }
+    }
+  }
+  model->delegate()->AddTabAt(GURL(), index, /*foreground=*/false, grupo);
+  tabs::TabInterface* nova =
+      model->GetTabAtIndex(index == -1 ? model->count() - 1 : index);
+  return nova && nova->GetGroup() == grupo ? nova->GetHandle()
+                                           : tabs::TabHandle();
+}
+
+// Depois de fechar: se a aba ativa foi junto, a aba nova do espaço fica ativa
+// (o Chromium podia escolher uma aba de outro espaço, a de quem abriu).
+void NavegadorAtivar(TabStripModel* model,
+                     tabs::TabHandle nova,
+                     bool fechou_a_ativa) {
+  tabs::TabInterface* aba = nova.Get();
+  if (!fechou_a_ativa || !aba) {
+    return;
+  }
+  const int index = model->GetIndexOfTab(aba);
+  if (index != TabStripModel::kNoTab && index != model->active_index()) {
+    model->ActivateTabAt(index);
+  }
+}
