+void TabStripModel::NavegadorRefazerDivisao(
+    split_tabs::SplitTabId split_id,
+    const std::vector<tabs::TabInterface*>& ordem,
+    split_tabs::SplitTabVisualData visual_data) {
+  ReentrancyCheck reentrancy_check(&reentrancy_guard_);
+
+  if (!ContainsSplit(split_id) ||
+      ordem.size() >
+          static_cast<size_t>(navegador::divisao::kMaximoDePaineis)) {
+    return;
+  }
+  for (tabs::TabInterface* aba : ordem) {
+    CHECK(aba);
+    CHECK_NE(GetIndexOfTab(aba), kNoTab);
+    CHECK(!aba->IsSplit() || aba->GetSplit() == split_id);
+  }
+
+  const std::vector<tabs::TabInterface*> antes =
+      GetSplitData(split_id)->ListTabs();
+  tabs::TabInterface* const ancora = antes[0];
+  const std::optional<tab_groups::TabGroupId> grupo = ancora->GetGroup();
+  const bool fixada = ancora->IsPinned();
+  const bool divisao_ativa = GetActiveTab()->GetSplit() == split_id;
+
+  // As que saem deixam de aparecer (como no RemoveSplit), menos a ativa.
+  if (divisao_ativa) {
+    for (tabs::TabInterface* aba : antes) {
+      if (!std::ranges::contains(ordem, aba) && !aba->IsActivated() &&
+          aba->IsVisible()) {
+        static_cast<tabs::TabModel*>(aba)->WillBecomeHidden(
+            base::PassKey<TabStripModel>());
+      }
+    }
+  }
+
+  RemoveSplitImpl(split_id,
+                  SplitTabChange::SplitTabRemoveReason::kSplitTabUpdated);
+  if (ordem.size() < 2u) {
+    return;
+  }
+
+  // Em fila, na ordem, começando onde a divisão estava; a que entra vem pro
+  // grupo (espaço) da divisão.
+  for (size_t k = 0; k < ordem.size(); ++k) {
+    tabs::TabInterface* const aba = ordem[k];
+    const int de = GetIndexOfTab(aba);
+    int para;
+    if (k == 0) {
+      const int referencia = GetIndexOfTab(ancora);
+      para = de < referencia ? referencia - 1 : referencia;
+    } else {
+      const int anterior = GetIndexOfTab(ordem[k - 1]);
+      para = de < anterior ? anterior : anterior + 1;
+    }
+    para = std::clamp(para, 0, count() - 1);
+    if (de != para || aba->IsPinned() != fixada || aba->GetGroup() != grupo) {
+      MoveTabToIndexImpl(de, para, grupo, fixada,
+                         /*select_after_move=*/false);
+    }
+  }
+
+  std::vector<int> indices;
+  for (tabs::TabInterface* aba : ordem) {
+    indices.push_back(GetIndexOfTab(aba));
+  }
+  std::ranges::sort(indices);
+  AddToSplitImpl(split_id, indices, indices[0],
+                 navegador::divisao::Normalizado(
+                     visual_data, static_cast<int>(indices.size())),
+                 SplitTabChange::SplitTabAddReason::kSplitTabUpdated);
+}
+
+void TabStripModel::NavegadorDesenharDivisao(
+    split_tabs::SplitTabId split_id,
+    split_tabs::SplitTabVisualData visual_data,
+    bool is_intermediate) {
+  ReentrancyCheck reentrancy_check(&reentrancy_guard_);
+
+  if (!ContainsSplit(split_id)) {
+    return;
+  }
+  split_tabs::SplitTabData* const split_data = GetSplitData(split_id);
+  visual_data = navegador::divisao::Normalizado(
+      visual_data, static_cast<int>(split_data->ListTabs().size()));
+  if (*split_data->visual_data() == visual_data) {
+    return;
+  }
+  const split_tabs::SplitTabVisualData antes = *split_data->visual_data();
+  *split_data->visual_data() = visual_data;
+  const bool so_tamanho =
+      antes.split_layout() == visual_data.split_layout() &&
+      navegador::divisao::Escrever(navegador::divisao::Igualar(
+          navegador::divisao::ArvoreDe(
+              antes, static_cast<int>(split_data->ListTabs().size())))) ==
+          navegador::divisao::Escrever(navegador::divisao::Igualar(
+              navegador::divisao::ArvoreDe(
+                  visual_data,
+                  static_cast<int>(split_data->ListTabs().size()))));
+  NotifySplitTabVisualsChanged(
+      split_id, antes, visual_data,
+      so_tamanho ? SplitTabChange::SplitVisualChangeReason::kRatioUpdated
+                 : SplitTabChange::SplitVisualChangeReason::kLayoutUpdated,
+      is_intermediate);
+}
+
+void TabStripModel::NavegadorRefazerDivisoesPendentes() {
+  std::vector<NavegadorDivisaoARefazer> pendentes;
+  std::swap(pendentes, navegador_divisoes_a_refazer_);
+  for (NavegadorDivisaoARefazer& pendente : pendentes) {
+    if (ContainsSplit(pendente.id)) {
+      continue;
+    }
+    std::vector<tabs::TabInterface*> abas;
+    std::vector<int> fora;
+    for (size_t k = 0; k < pendente.abas.size(); ++k) {
+      tabs::TabInterface* const aba = pendente.abas[k].Get();
+      if (!aba || GetIndexOfTab(aba) == kNoTab || aba->IsSplit()) {
+        fora.push_back(static_cast<int>(k));
+        continue;
+      }
+      abas.push_back(aba);
+    }
+    if (abas.size() < 2u) {
+      continue;
+    }
+    std::vector<int> indices;
+    for (tabs::TabInterface* aba : abas) {
+      indices.push_back(GetIndexOfTab(aba));
+    }
+    std::ranges::sort(indices);
+    // Juntas (a que saiu estava no meio delas) e com o mesmo grupo e fixação:
+    // senão ficam soltas.
+    bool juntas = indices.back() - indices.front() + 1 ==
+                  static_cast<int>(indices.size());
+    for (tabs::TabInterface* aba : abas) {
+      juntas = juntas && aba->GetGroup() == abas[0]->GetGroup() &&
+               aba->IsPinned() == abas[0]->IsPinned();
+    }
+    if (!juntas) {
+      continue;
+    }
+    AddToSplitImpl(pendente.id, indices, indices[0],
+                   navegador::divisao::SemPaineis(
+                       pendente.visual, static_cast<int>(pendente.abas.size()),
+                       fora),
+                   SplitTabChange::SplitTabAddReason::kSplitTabUpdated);
+  }
+}
