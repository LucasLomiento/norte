+void MultiContentsViewDelegateImpl::NavegadorDesenhar(
+    const split_tabs::SplitTabVisualData& visual_data,
+    bool fim) {
+  tabs::TabInterface* const ativa = tab_strip_model_->GetActiveTab();
+  if (!ativa || !ativa->IsSplit()) {
+    return;
+  }
+  const split_tabs::SplitTabId divisao = *ativa->GetSplit();
+  tab_strip_model_->NavegadorDesenharDivisao(divisao, visual_data,
+                                             /*is_intermediate=*/!fim);
+  // Ao soltar, o desenho costuma ser igual ao do último passo (que foi
+  // intermediário e não avisou a sessão): grava aqui, como o
+  // ResizeWebContents.
+  if (fim) {
+    if (SessionService* const session_service =
+            SessionServiceFactory::GetForProfile(browser_->GetProfile())) {
+      session_service->SetSplitTabData(
+          browser_->GetSessionID(), divisao,
+          tab_strip_model_->GetSplitData(divisao)->visual_data());
+    }
+  }
+}
