+// navegador: as regras do bloqueador chegam antes do documento delas (o
+// navegador manda quando a navegação está pronta pra começar) e ficam
+// guardadas até o começo dele (DidCreateDocumentElement). Se chegarem depois
+// que ele começou (a ordem entre os canais não é garantida), aplicam na hora.
+void ChromeRenderFrameObserver::NavegadorEsconderAnuncios(
+    const std::string& css,
+    const std::string& js,
+    const std::string& estilo,
+    const GURL& url) {
+  NavegadorRegras regras{url, css, js, estilo};
+  blink::WebLocalFrame* quadro = render_frame()->GetWebFrame();
+  if (!navegador_aplicado_ && !quadro->IsProvisional() &&
+      !quadro->GetDocument().IsNull() &&
+      !quadro->GetDocument().DocumentElement().IsNull() &&
+      url::Origin::Create(GURL(quadro->GetDocument().Url())) ==
+          url::Origin::Create(url)) {
+    NavegadorAplicar(regras);
+    return;
+  }
+  navegador_pendente_ = std::move(regras);
+}
+
+void ChromeRenderFrameObserver::DidCreateDocumentElement() {
+  if (!navegador_pendente_ || navegador_aplicado_) {
+    return;
+  }
+  blink::WebDocument documento = render_frame()->GetWebFrame()->GetDocument();
+  // O documento vazio inicial (about:blank) de uma aba nova não é o delas.
+  if (url::Origin::Create(GURL(documento.Url())) !=
+      url::Origin::Create(navegador_pendente_->url)) {
+    return;
+  }
+  NavegadorRegras regras = std::move(*navegador_pendente_);
+  navegador_pendente_.reset();
+  NavegadorAplicar(regras);
+}
+
+// CSS como folha de origem do usuário (fora do DOM: a página não vê nem
+// sobrescreve, nem com !important); JS no mundo da página, antes dos
+// scripts dela.
+void ChromeRenderFrameObserver::NavegadorAplicar(
+    const NavegadorRegras& regras) {
+  navegador_aplicado_ = true;
+  blink::WebLocalFrame* quadro = render_frame()->GetWebFrame();
+  if (!regras.js.empty()) {
+    quadro->ExecuteScript(
+        blink::WebScriptSource(blink::WebString::FromUtf8(regras.js)));
+  }
+  if (!regras.css.empty()) {
+    quadro->GetDocument().InsertStyleSheet(
+        blink::WebString::FromUtf8(regras.css), nullptr,
+        blink::WebCssOrigin::kUser);
+  }
+  // O estilo da pessoa: folha do autor, por cima das do site (sem precisar
+  // de !important, como num CSS da própria página).
+  if (!regras.estilo.empty()) {
+    quadro->GetDocument().InsertStyleSheet(
+        blink::WebString::FromUtf8(regras.estilo), nullptr,
+        blink::WebCssOrigin::kAuthor);
+  }
+}
+
 void ChromeRenderFrameObserver::SetShouldDeferMediaLoad(bool should_defer) {
   prerender::SetShouldDeferMediaLoad(render_frame(), should_defer);
 }
