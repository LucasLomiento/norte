+// navegador: vigia de quadros presos (WaylandFrameManager). O compositor
+// para de mandar o callback de quadro: sem ninguém mexendo na janela (tela
+// desligada, janela escondida) nada acontece; com um clique e o compositor
+// respondendo dentro da folga, também não; com um clique e nada andando por
+// 5 s, o processo da GPU é reiniciado uma vez.
+TEST_P(WaylandBufferManagerTest, NavegadorVigiaDeQuadrosPresos) {
+  WaylandFrameManager::NavegadorZerarReinicioParaTeste();
+  constexpr uint32_t kBufferId1 = 1;
+  constexpr uint32_t kBufferId2 = 2;
+  constexpr uint32_t kBufferId3 = 3;
+  const gfx::AcceleratedWidget widget = window_->GetWidget();
+  const gfx::Rect bounds = window_->GetBoundsInPixels();
+  MockSurfaceGpu mock_surface_gpu(buffer_manager_gpu_.get(), widget);
+  EXPECT_CALL(mock_surface_gpu, OnSubmission(_, _, _))
+      .Times(testing::AnyNumber());
+  EXPECT_CALL(mock_surface_gpu, OnPresentation(_, _))
+      .Times(testing::AnyNumber());
+
+  CreateShmBasedBufferAndSetTerminateExpecation(false /*fail*/, kBufferId1);
+  CreateShmBasedBufferAndSetTerminateExpecation(false /*fail*/, kBufferId2);
+  CreateShmBasedBufferAndSetTerminateExpecation(false /*fail*/, kBufferId3);
+
+  PostToServerAndWait([](wl::TestWaylandServerThread* server) {
+    wl_seat_send_capabilities(server->seat()->resource(),
+                              WL_SEAT_CAPABILITY_POINTER);
+  });
+  ASSERT_TRUE(connection_->seat()->pointer());
+  auto clicar = [this]() {
+    PostToServerAndWait([id = surface_id_](
+                            wl::TestWaylandServerThread* server) {
+      wl::MockSurface* surface = server->GetObject<wl::MockSurface>(id);
+      auto* pointer = server->seat()->pointer()->resource();
+      wl_pointer_send_enter(pointer, server->GetNextSerial(),
+                            surface->resource(), 0, 0);
+      wl_pointer_send_frame(pointer);
+      wl_pointer_send_button(pointer, server->GetNextSerial(),
+                             server->GetNextTime(), BTN_LEFT,
+                             WL_POINTER_BUTTON_STATE_PRESSED);
+      wl_pointer_send_frame(pointer);
+      wl_pointer_send_button(pointer, server->GetNextSerial(),
+                             server->GetNextTime(), BTN_LEFT,
+                             WL_POINTER_BUTTON_STATE_RELEASED);
+      wl_pointer_send_frame(pointer);
+    });
+  };
+
+  CommitBuffer(widget, kBufferId1, kBufferId1,
+               gfx::FrameData(delegate_.viz_seq()), bounds,
+               gfx::RoundedCornersF(), kDefaultScale, bounds);
+  // O segundo quadro espera o callback do primeiro, que não vem.
+  CommitBuffer(widget, kBufferId2, kBufferId2,
+               gfx::FrameData(delegate_.viz_seq()), bounds,
+               gfx::RoundedCornersF(), kDefaultScale, bounds);
+
+  // Sem ninguém mexendo: nada.
+  EXPECT_CALL(callback_, Run(_)).Times(0);
+  task_environment_.FastForwardBy(base::Seconds(20));
+  testing::Mock::VerifyAndClearExpectations(&callback_);
+
+  // Um clique, e o compositor responde antes da folga: nada.
+  EXPECT_CALL(callback_, Run(_)).Times(0);
+  clicar();
+  task_environment_.FastForwardBy(base::Seconds(2));
+  SendFrameCallbackForSurface(surface_id_);
+  task_environment_.FastForwardBy(base::Seconds(20));
+  testing::Mock::VerifyAndClearExpectations(&callback_);
+
+  // O terceiro quadro espera o callback do segundo, que não vem. Um clique e
+  // nada anda: reinicia a GPU.
+  CommitBuffer(widget, kBufferId3, kBufferId3,
+               gfx::FrameData(delegate_.viz_seq()), bounds,
+               gfx::RoundedCornersF(), kDefaultScale, bounds);
+  EXPECT_CALL(callback_, Run(_)).Times(0);
+  clicar();
+  task_environment_.FastForwardBy(base::Seconds(4));
+  testing::Mock::VerifyAndClearExpectations(&callback_);
+  EXPECT_CALL(callback_, Run(_)).Times(1);
+  task_environment_.FastForwardBy(base::Seconds(2));
+  testing::Mock::VerifyAndClearExpectations(&callback_);
+
+  // O callback de terminar é de uso único: devolve pro resto do teste.
+  manager_host_->SetTerminateGpuCallback(callback_.Get());
+  EXPECT_CALL(callback_, Run(_)).Times(0);
+  // Logo depois, outro clique preso não reinicia de novo (no máximo uma vez
+  // a cada 5 min).
+  clicar();
+  task_environment_.FastForwardBy(base::Seconds(10));
+  testing::Mock::VerifyAndClearExpectations(&callback_);
+}
