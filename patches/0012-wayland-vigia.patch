+// navegador: com o NVIDIA 615 no Hyprland, a janela às vezes deixa de
+// receber os callbacks de quadro e as liberações de buffer do compositor. O
+// processo da GPU fica esperando pra sempre: a tela congela com a interface
+// viva (o clique dá play no vídeo, mas nada se redesenha). Reiniciar o processo
+// da GPU destrava. O vigia só liga quando a pessoa mexe na janela com quadro
+// esperando o compositor, e só age se nada andar em kNavegadorFolgaDaTrava:
+// janela escondida ou tela desligada (DPMS) não recebem clique, e quando a
+// tela acorda o compositor volta a responder antes disso.
+bool WaylandFrameManager::NavegadorEsperandoCompositor() const {
+  if (!pending_frames_.empty()) {
+    return true;
+  }
+  for (const auto& frame : submitted_frames_) {
+    if (!frame->submission_acked) {
+      return true;
+    }
+  }
+  return false;
+}
+
+void WaylandFrameManager::NavegadorUsuarioAgiu() {
+  if (navegador_vigia_.IsRunning() || window_->IsSuspended() ||
+      !NavegadorEsperandoCompositor()) {
+    return;
+  }
+  navegador_vigia_.Start(FROM_HERE, kNavegadorFolgaDaTrava, this,
+                         &WaylandFrameManager::NavegadorConferirTrava);
+}
+
+void WaylandFrameManager::NavegadorConferirTrava() {
+  if (window_->IsSuspended() || !NavegadorEsperandoCompositor()) {
+    return;
+  }
+  const base::TimeTicks agora = base::TimeTicks::Now();
+  if (!g_navegador_ultimo_reinicio.is_null() &&
+      agora - g_navegador_ultimo_reinicio < kNavegadorIntervaloDeReinicio) {
+    return;
+  }
+  LOG(ERROR) << "Quadros presos no compositor por "
+             << kNavegadorFolgaDaTrava.InSeconds()
+             << " s: reiniciando o processo da GPU (pendentes="
+             << pending_frames_.size()
+             << ", enviados=" << submitted_frames_.size() << ")";
+  if (connection_->buffer_manager_host()->NavegadorReiniciarGpu(
+          "Quadros presos no compositor")) {
+    g_navegador_ultimo_reinicio = agora;
+  }
+}
