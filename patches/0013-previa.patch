+
+int MultiContentsView::NavegadorPainelEm(const gfx::Point& ponto) const {
+  if (!GetLocalBounds().Contains(ponto)) {
+    return -1;
+  }
+  int mais_perto = -1;
+  int64_t distancia = 0;
+  for (int i = 0; i < paineis_; ++i) {
+    const gfx::Rect r = contents_container_views_[i]->bounds();
+    if (r.Contains(ponto)) {
+      return i;
+    }
+    const int dx = std::max({r.x() - ponto.x(), 0, ponto.x() - r.right()});
+    const int dy = std::max({r.y() - ponto.y(), 0, ponto.y() - r.bottom()});
+    const int64_t d = static_cast<int64_t>(dx) * dx + static_cast<int64_t>(dy) * dy;
+    if (mais_perto < 0 || d < distancia) {
+      mais_perto = i;
+      distancia = d;
+    }
+  }
+  return mais_perto;
+}
