+void MultiContentsView::NavegadorRedimensionar(int indice,
+                                               int quanto,
+                                               bool fim) {
+  if (!IsInSplitView()) {
+    return;
   }
+  // As páginas só se refazem quando o mouse para (ou ao soltar).
+  if (fim) {
+    navegador_assentar_.Stop();
+    NavegadorRapido(false);
+  } else {
+    NavegadorRapido(true);
+    navegador_assentar_.Start(
+        FROM_HERE, base::Milliseconds(120),
+        base::BindOnce(&MultiContentsView::NavegadorAssentar,
+                       base::Unretained(this)));
+  }
+  if (!arvore_no_inicio_ || divisor_arrastado_ != indice) {
+    arvore_no_inicio_ = navegador::divisao::ArvoreDe(visual_data_, paineis_);
+    area_no_inicio_ = NavegadorAreaDosPaineis();
+    divisor_arrastado_ = indice;
+  }
+  const navegador::divisao::Retangulo area{
+      area_no_inicio_.x(), area_no_inicio_.y(), area_no_inicio_.width(),
+      area_no_inicio_.height()};
+  const navegador::divisao::Desenho desenho =
+      navegador::divisao::Calcular(*arvore_no_inicio_, area, NavegadorEspaco());
+  if (indice >= 0 && indice < static_cast<int>(desenho.divisores.size())) {
+    const navegador::divisao::Divisor& divisor = desenho.divisores[indice];
+    // O menor painel: como o Chromium (10% da janela, entre 50 e 200 px).
+    const int minimo = std::clamp(
+        static_cast<int>(kMinWebContentsSizePercentage *
+                         std::max(area_no_inicio_.width(),
+                                  area_no_inicio_.height())),
+        kConstrainedMinWebContentsSize,
+        min_contents_size_for_testing_.value_or(kMinWebContentsSize));
+    delegate_->NavegadorDesenhar(
+        navegador::divisao::VisualDe(navegador::divisao::Redimensionar(
+            *arvore_no_inicio_, area, NavegadorEspaco(), divisor.caminho,
+            divisor.indice, quanto, minimo)),
+        fim);
+  }
+  if (fim) {
+    arvore_no_inicio_.reset();
+    divisor_arrastado_ = -1;
+  }
+}
+
+void MultiContentsView::NavegadorRapido(bool rapido) {
+  if (navegador_rapido_ == rapido) {
+    return;
+  }
+  navegador_rapido_ = rapido;
+  for (int i = 0; i < paineis_; ++i) {
+    ContentsWebView* const pagina =
+        contents_container_views_[i]->contents_view();
+    pagina->SetFastResize(rapido);
+    if (!rapido) {
+      // Com o mesmo tamanho de antes o NativeViewHost não refaz o layout
+      // sozinho, e a página ficaria recortada no tamanho velho.
+      pagina->holder()->InvalidateLayout();
+    }
+  }
+}
+
+void MultiContentsView::NavegadorAssentar() {
+  // O mouse parou no meio do arrasto: as páginas se refazem no tamanho de
+  // agora, e o arrasto continua rápido.
+  NavegadorRapido(false);
+  DeprecatedLayoutImmediately();
+  NavegadorRapido(true);
+}
+
+void MultiContentsView::NavegadorDuploClique(int indice) {
+  if (!IsInSplitView()) {
+    return;
+  }
+  if (paineis_ <= 2) {
+    OnSwap();
+    return;
+  }
+  const navegador::divisao::No arvore =
+      navegador::divisao::ArvoreDe(visual_data_, paineis_);
+  const navegador::divisao::Desenho desenho = navegador::divisao::Calcular(
+      arvore, navegador::divisao::Retangulo{0, 0, 1000, 1000}, 0);
+  if (indice < 0 || indice >= static_cast<int>(desenho.divisores.size())) {
+    return;
+  }
+  delegate_->NavegadorDesenhar(
+      navegador::divisao::VisualDe(navegador::divisao::IgualarNo(
+          arvore, desenho.divisores[indice].caminho)),
+      /*fim=*/true);
+}
