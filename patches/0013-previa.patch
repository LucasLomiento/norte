+void MultiContentsView::NavegadorMostrarPaginas(
+    const std::vector<content::WebContents*>& paginas,
+    int ativa,
+    const split_tabs::SplitTabVisualData& visual_data) {
+  const int n = std::clamp(static_cast<int>(paginas.size()), 1,
+                           kNavegadorMaximoDePaineis);
+  // Os painéis que já mostram uma das páginas vão pro lugar dela; os outros
+  // preenchem o resto, na ordem.
+  std::vector<raw_ptr<ContentsContainerView, DanglingUntriaged>> novos(
+      contents_container_views_.size(), nullptr);
+  std::vector<bool> usado(contents_container_views_.size(), false);
+  for (int i = 0; i < n; ++i) {
+    for (size_t j = 0; j < contents_container_views_.size(); ++j) {
+      if (!usado[j] && paginas[i] &&
+          contents_container_views_[j]->contents_view()->web_contents() ==
+              paginas[i]) {
+        novos[i] = contents_container_views_[j];
+        usado[j] = true;
+        break;
+      }
+    }
+  }
+  for (size_t i = 0, j = 0; i < novos.size(); ++i) {
+    if (novos[i]) {
+      continue;
+    }
+    while (usado[j]) {
+      ++j;
+    }
+    novos[i] = contents_container_views_[j];
+    usado[j] = true;
+  }
+  contents_container_views_ = std::move(novos);
+  NavegadorReordenarFilhos();
+
+  visual_data_ = visual_data;
+  NavegadorDefinirPaineis(n);
+  for (int i = 0; i < n; ++i) {
+    ContentsWebView* const pagina =
+        contents_container_views_[i]->contents_view();
+    if (pagina->web_contents() != paginas[i]) {
+      pagina->SetWebContents(paginas[i]);
+      SafeInvoke(paginas[i])
+          .Then(Overload<content::WebContents*>(
+              &tabs::TabInterface::MaybeGetFromContents))
+          .Then(&SadTabHelper::From)
+          .Then(&SadTabHelper::ReinstallInWebView);
+    }
+  }
+  SetActiveIndex(std::clamp(ativa, 0, n - 1));
+  NavegadorAtualizarDivisores();
+  InvalidateLayout();
+}
+
