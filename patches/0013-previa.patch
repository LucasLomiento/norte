+
+void MultiContentsView::NavegadorDefinirPaineis(int paineis) {
+  paineis = std::clamp(paineis, 1, kNavegadorMaximoDePaineis);
+  // O painel ativo fica entre os que aparecem.
+  if (active_index_ >= paineis) {
+    std::swap(contents_container_views_[0],
+              contents_container_views_[active_index_]);
+    active_index_ = 0;
+    NavegadorReordenarFilhos();
+  }
+  for (int i = 0; i < kNavegadorMaximoDePaineis; ++i) {
+    ContentsContainerView* const container = contents_container_views_[i];
+    if (i >= paineis) {
+      container->contents_view()->SetWebContents(nullptr);
+    }
+    container->SetVisible(i < paineis);
+  }
+  if (paineis_ != paineis) {
+    paineis_ = paineis;
+    NavegadorAtualizarDivisores();
+    UpdateContentsBorderAndOverlay();
+    InvalidateLayout();
+  }
+}
+
+void MultiContentsView::NavegadorAtualizarDivisores() {
+  // As frestas (e o lado de cada uma) não dependem do tamanho da área.
+  const navegador::divisao::Desenho desenho =
+      NavegadorDesenho(gfx::Rect(0, 0, 1000, 1000));
+  for (size_t j = 0; j < divisores_.size(); ++j) {
+    const bool visivel =
+        IsInSplitView() && j < desenho.divisores.size();
+    if (visivel) {
+      divisores_[j]->SetLayout(desenho.divisores[j].em_pe
+                                   ? split_tabs::SplitTabLayout::kSideBySide
+                                   : split_tabs::SplitTabLayout::kStacked);
+    }
+    divisores_[j]->SetVisible(visivel);
+  }
+  for (size_t i = 0; i < alcas_.size(); ++i) {
+    alcas_[i]->SetVisible(IsInSplitView() && static_cast<int>(i) < paineis_);
+    alcas_[i]->SetAtiva(static_cast<int>(i) == active_index_);
+  }
+  if (vigia_) {
+    vigia_->Ligar(IsInSplitView());
+  }
+}
+
+void MultiContentsView::NavegadorReordenarFilhos() {
+  // Os painéis ocupam as primeiras posições depois do fundo, na ordem.
+  const size_t primeiro = GetIndexOf(background_view_).value_or(0) + 1;
+  for (size_t i = 0; i < contents_container_views_.size(); ++i) {
+    ReorderChildView(contents_container_views_[i], primeiro + i);
+  }
+}
+
+navegador::divisao::Desenho MultiContentsView::NavegadorDesenho(
+    const gfx::Rect& area) const {
+  const navegador::divisao::Retangulo retangulo{area.x(), area.y(),
+                                                area.width(), area.height()};
+  if (paineis_ <= 1) {
+    navegador::divisao::Desenho desenho;
+    desenho.paineis.push_back(retangulo);
+    return desenho;
