@@ -27,6 +34,57 @@ using base::nix::kXdgConfigHomeEnvVar;
 
 namespace {
 
+// navegador: o navegador se chamava "Navegador" (perfil em ~/.config/navegador
+// e cache em ~/.cache/navegador) e virou Norte. Na primeira vez, as pastas
+// mudam de lugar (logins, espaços, containers e senhas vão junto: a chave
+// das senhas no chaveiro do sistema não depende do nome). Se o antigo ainda
+// está aberto na pasta (SingletonLock de um processo vivo, como no meio da
+// atualização), usa a antiga desta vez e muda numa próxima.
+//
+// Só o processo principal muda: os filhos (rede, armazenamento...) rodam num
+// sandbox com outro espaço de PIDs, não enxergam o processo do antigo e
+// achariam a trava abandonada, mudando a pasta com o navegador aberto.
+base::FilePath MudarDoNomeAntigo(const base::FilePath& antigo,
+                                 const base::FilePath& novo) {
+  static bool tentou = false;
+  const bool principal = base::CommandLine::InitializedForCurrentProcess() &&
+                         !base::CommandLine::ForCurrentProcess()->HasSwitch(
+                             "type");
+  if (tentou || !principal) {
+    return base::DirectoryExists(novo) || !base::DirectoryExists(antigo)
+               ? novo
+               : antigo;
+  }
+  tentou = true;
+  if (base::PathExists(novo) || !base::DirectoryExists(antigo)) {
+    return novo;
+  }
+  base::FilePath trava;
+  if (base::ReadSymbolicLink(antigo.Append("SingletonLock"), &trava)) {
+    // "máquina-pid".
+    const std::string& texto = trava.value();
+    const size_t traco = texto.rfind('-');
+    int pid = 0;
+    if (traco != std::string::npos &&
+        base::StringToInt(texto.substr(traco + 1), &pid) && pid > 0 &&
+        (kill(pid, 0) == 0 || errno == EPERM)) {
+      return antigo;
+    }
+  }
+  if (rename(antigo.value().c_str(), novo.value().c_str()) != 0) {
+    return antigo;
+  }
+  base::FilePath cache;
+  if (base::PathService::Get(base::DIR_CACHE, &cache)) {
+    const base::FilePath cache_antigo = cache.Append(antigo.BaseName());
+    const base::FilePath cache_novo = cache.Append(novo.BaseName());
+    if (base::DirectoryExists(cache_antigo) && !base::PathExists(cache_novo)) {
+      rename(cache_antigo.value().c_str(), cache_novo.value().c_str());
+    }
+  }
+  return novo;
+}
+
