+
+void ChromeAutocompleteProviderClient::NavegadorLembrar(
+    const std::u16string& texto,
+    base::OnceCallback<void(std::vector<NavegadorLembranca>)> pronto) {
+#if !BUILDFLAG(IS_ANDROID)
+  navegador::memoria::Filtro filtro;
+  filtro.consulta = texto;
+  filtro.limite = 3;
+  filtro.tamanho_do_trecho = 120;
+  navegador::memoria::BuscarDaBarra(
+      profile_, std::move(filtro),
+      base::BindOnce(
+          [](base::OnceCallback<void(std::vector<NavegadorLembranca>)> pronto,
+             std::vector<navegador::memoria::Resultado> resultados) {
+            std::vector<NavegadorLembranca> lembrancas;
+            for (const navegador::memoria::Resultado& r : resultados) {
+              NavegadorLembranca lembranca;
+              lembranca.url = navegador::memoria::EnderecoNoTrecho(r);
+              lembranca.titulo = r.titulo;
+              lembranca.trecho = r.trecho.texto;
+              lembranca.destaques = r.trecho.destaques;
+              lembrancas.push_back(std::move(lembranca));
+            }
+            std::move(pronto).Run(std::move(lembrancas));
+          },
+          std::move(pronto)));
+#else
+  std::move(pronto).Run({});
+#endif  // !BUILDFLAG(IS_ANDROID)
+}
+
+void ChromeAutocompleteProviderClient::NavegadorEsquecer(const GURL& url) {
+#if !BUILDFLAG(IS_ANDROID)
+  navegador::memoria::EsquecerEndereco(profile_, url);
+#endif  // !BUILDFLAG(IS_ANDROID)
+}
+
+void ChromeAutocompleteProviderClient::NavegadorExecutar(
+    const std::string& id) {
+#if !BUILDFLAG(IS_ANDROID)
+  navegador::comandos::Executar(profile_, id);
+#endif  // !BUILDFLAG(IS_ANDROID)
+}
