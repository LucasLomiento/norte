+// navegador: o menu com menos cara de Chromium. Saem os itens que não usamos
+// (transmitir, modo de leitura, ouvir a página, lista de leitura), os comuns
+// ganham ícone e o código-fonte, um nome curto.
+void NavegadorArrumarMenu(ui::SimpleMenuModel& menu) {
+  for (int id : {IDC_ROUTE_MEDIA, IDC_CONTENT_CONTEXT_OPEN_IN_READING_MODE,
+                 IDC_CONTENT_CONTEXT_LISTEN_TO_THIS_PAGE,
+                 IDC_CONTENT_CONTEXT_ADD_LINK_TO_READING_LIST}) {
+    if (std::optional<size_t> i = menu.GetIndexOfCommandId(id)) {
+      menu.RemoveItemAt(*i);
+    }
+  }
+  // Separadores que sobraram: no começo, no fim ou dois seguidos.
+  for (size_t i = menu.GetItemCount(); i-- > 0;) {
+    if (menu.GetTypeAt(i) == ui::MenuModel::TYPE_SEPARATOR &&
+        (i == 0 || i + 1 == menu.GetItemCount() ||
+         menu.GetTypeAt(i - 1) == ui::MenuModel::TYPE_SEPARATOR)) {
+      menu.RemoveItemAt(i);
+    }
+  }
+  for (size_t i = 0; i < menu.GetItemCount(); ++i) {
+    if (const gfx::VectorIcon* icone =
+            NavegadorIconeDoItem(menu.GetCommandIdAt(i))) {
+      menu.SetIcon(i, ui::ImageModel::FromVectorIcon(
+                          *icone, ui::kColorMenuIcon,
+                          ui::SimpleMenuModel::kDefaultIconSize));
+    }
+  }
+  if (std::optional<size_t> i = menu.GetIndexOfCommandId(IDC_VIEW_SOURCE)) {
+    menu.SetLabel(*i, u"Ver código-fonte");
+  }
+}
