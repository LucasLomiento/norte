+// static
+std::optional<std::string> NotificationIdGenerator::NavegadorParticao(
+    std::string_view notification_id) {
+  if (!IsPersistentNotification(notification_id)) {
+    return std::nullopt;
+  }
+  const size_t marca = notification_id.rfind(kNavegadorMarca);
+  if (marca == std::string_view::npos ||
+      marca + kNavegadorMarca.size() == notification_id.size()) {
+    return std::nullopt;
+  }
+  return std::string(notification_id.substr(marca + kNavegadorMarca.size()));
+}
